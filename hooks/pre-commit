#!/bin/sh
# EMN_labOS identity guard — profile-aware.
#   Work    (JourneyOS / Yaqeen: origin on yaqeen-institute, or path under ~/YaqeenProjects)
#           -> author malick.ndiaye@yaqeeninstitute.org; work-email allowed in content.
#   Personal (EMN_labOS / everything else)
#           -> author nmalicksn@gmail.com; work-email treated as a leak and blocked.
# Both profiles block private keys / service-account / firebase-adminsdk secrets.

toplevel=$(git rev-parse --show-toplevel 2>/dev/null)
remote=$(git remote get-url origin 2>/dev/null)
if printf '%s\n%s\n' "$remote" "$toplevel" | grep -qiE 'yaqeen-institute|/YaqeenProjects/'; then
  PROFILE=work
  EXPECTED="malick.ndiaye@yaqeeninstitute.org"
  SECRET_RE='BEGIN (RSA |EC )?PRIVATE KEY|serviceAccount|firebase-adminsdk'
else
  PROFILE=personal
  EXPECTED="nmalicksn@gmail.com"
  SECRET_RE='BEGIN (RSA |EC )?PRIVATE KEY|yaqeeninstitute\.org|serviceAccount|firebase-adminsdk'
fi

[ "$(git config user.email)" = "$EXPECTED" ] || { echo "BLOCKED [$PROFILE]: author != $EXPECTED"; exit 1; }

# Scan staged additions for secrets (+ work-email leak on personal). Exclude hooks/ — it defines these patterns by design.
files=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^hooks/')
if [ -n "$files" ]; then
  hits=$(printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 grep -lEI "$SECRET_RE" 2>/dev/null)
  if [ -n "$hits" ]; then
    echo "BLOCKED [$PROFILE]: secret/disallowed content in staged files:"; echo "$hits"; exit 1
  fi
fi
exit 0
