#!/bin/sh
# EMN_labOS identity guard — profile-aware, data-driven.
# Logic is public; identifiers/patterns live in gitignored hooks/identities.local.
#   Work profile:     work author expected; work-domain content allowed.
#   Personal profile: personal author expected; work-domain content treated as a leak.
# Both profiles block secret-shaped content in STAGED BLOBS (scans the index, not the
# worktree). .gitignore files are exempt from content scans — they name secret-file
# patterns by design. Escape hatch for unrelated repos: git config labos.profile none

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
IDF="$HOOK_DIR/identities.local"
if [ ! -f "$IDF" ]; then
  echo "BLOCKED: $IDF missing — the identity wall cannot run without it." >&2
  echo "         Restore it from the machine archive or recreate per hooks/README." >&2
  exit 1
fi
. "$IDF"

[ "$(git config labos.profile 2>/dev/null)" = "none" ] && exit 0

toplevel=$(git rev-parse --show-toplevel 2>/dev/null)
remote=$(git remote get-url origin 2>/dev/null)
if printf '%s\n%s\n' "$remote" "$toplevel" | grep -qiE "$WORK_MATCH_RE"; then
  PROFILE=work;     EXPECTED="$WORK_EMAIL";     SECRET_RE="$SECRET_RE_COMMON"
else
  PROFILE=personal; EXPECTED="$PERSONAL_EMAIL"; SECRET_RE="$SECRET_RE_COMMON|$PERSONAL_EXTRA_RE"
fi

# The designated private config repo (CONFIG_REPO_RE — machine-local, like every other
# identifier here) is the ONE repo allowed to hold the machine-local identity data in git.
# It is private, personal-account-only, and it exists so a fresh machine can restore
# hooks/identities.local — without it the hooks fail closed and every commit is blocked.
# The AUTHOR CHECK STILL RUNS there. Only two things are skipped: the identities.local
# filename rule, and the secret-content scan — that file's entire purpose is to carry the
# token lists the scan looks for, so the scan can never pass on it. Personal profile only:
# a repo matching both WORK_MATCH_RE and CONFIG_REPO_RE is a misconfiguration, not an
# exception, and keeps the full scan.
IS_CONFIG=0
if [ "$PROFILE" = "personal" ] && [ -n "${CONFIG_REPO_RE:-}" ] &&
   printf '%s\n%s\n' "$remote" "$toplevel" | grep -qiE "$CONFIG_REPO_RE"; then
  IS_CONFIG=1
fi

# Author check — config AND effective ident (catches GIT_AUTHOR_EMAIL= laundering).
[ "$(git config user.email)" = "$EXPECTED" ] || { echo "BLOCKED [$PROFILE]: git config user.email != $EXPECTED" >&2; exit 1; }
case "$(git var GIT_AUTHOR_IDENT 2>/dev/null)" in
  *"<$EXPECTED>"*) : ;;
  *) echo "BLOCKED [$PROFILE]: effective author ident != $EXPECTED (env override?)" >&2; exit 1 ;;
esac

# identities.local must never be staged, anywhere — except in the designated config repo,
# whose job is to carry it (see IS_CONFIG above).
if [ "$IS_CONFIG" = "0" ] && git diff --cached --name-only -z | tr '\0' '\n' | grep -qE '(^|/)identities\.local$'; then
  echo "BLOCKED [$PROFILE]: hooks/identities.local is staged — it is machine-local by design." >&2
  exit 1
fi

# Is this the labOS public repo (primary checkout or one of its worktrees)?
IS_LABOS=0
printf '%s' "$toplevel" | grep -qE "$LABOS_ROOT_RE" && IS_LABOS=1

ALLOW_LOCAL="$HOOK_DIR/allowlist.local"     # machine-local per-path exceptions
LABOS_ALLOW="$toplevel/.labos-allow"        # tracked: paths that legitimately describe the wall

path_in_list() { # $1=path $2=listfile — prefix match per line; comments/blank skipped
  [ -f "$2" ] || return 1
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    case "$1" in "$line"*) return 0 ;; esac
  done < "$2"
  return 1
}

tmpfail="$(mktemp)"; : > "$tmpfail"
git diff --cached --name-only -z --diff-filter=ACMR | tr '\0' '\n' | while IFS= read -r f; do
  [ -n "$f" ] || continue
  path_in_list "$f" "$ALLOW_LOCAL" && continue
  base="${f##*/}"
  # Secret scan (index blob, not worktree). .gitignore exempt by design; the config repo is
  # exempt because it stores the token lists themselves.
  if [ "$base" != ".gitignore" ] && [ "$IS_CONFIG" = "0" ]; then
    if git show ":$f" 2>/dev/null | grep -qIE "$SECRET_RE"; then
      echo "BLOCKED [$PROFILE]: secret-shaped content in staged blob: $f" >&2
      echo 1 >> "$tmpfail"
    fi
  fi
  # labOS public-repo token scan.
  if [ "$IS_LABOS" = "1" ] && ! path_in_list "$f" "$LABOS_ALLOW"; then
    if git show ":$f" 2>/dev/null | grep -qiIE "$LABOS_COMMIT_TOKENS"; then
      echo "BLOCKED [labos-public]: work/client token in staged blob: $f" >&2
      echo "  (If this file legitimately describes the wall, add its path to .labos-allow — reviewer-gated.)" >&2
      echo 1 >> "$tmpfail"
    fi
  fi
done
if [ -s "$tmpfail" ]; then rm -f "$tmpfail"; exit 1; fi
rm -f "$tmpfail"
exit 0
