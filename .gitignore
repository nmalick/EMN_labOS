# EMN_labOS — DENY ALL, then allowlist only OS files. Project folders are NEVER tracked.
/*
**
# OS scaffold (dir entries before file entries)
!/.gitignore
!/README.md
!/CLAUDE.md
!/DIRECTORY.md
!/STATUS.md
!/ROADMAP.md
!/RELEASE-NOTES.md
!/now.md
!/projects.json
!/.mcp.json
!/.claude/
!/.claude/.gitkeep
!/.claude/settings.json
!/.claude/agents/
!/.claude/agents/**
!/.claude/commands/
!/.claude/commands/**
!/.claude/skills/
!/.claude/skills/**
!/registry/
!/registry/**
!/templates/
!/templates/**
!/docs/
!/docs/**
!/hooks/
!/hooks/**
!/claude-output-docs/
!/claude-output-docs/**
!/scripts/
!/scripts/**
!/home-claude/
!/home-claude/**
!/manifest.sh
!/.labos-allow
!/.github/
!/.github/**
!/tests/
!/tests/**
# POC tracked in-repo by exception (approved) — normally pocs/ is never tracked.
# Children are re-denied and narrowed in the gitlink guard at the bottom.
!/pocs/
# Hard re-exclusions (never track even if allowlisted)
/hooks/*.local
.DS_Store
**/.git
**/node_modules/
**/__pycache__/
.env
.env.*
**/.vercel/
*.bundle
# Agent worktrees live under .claude/, which is allowlisted above — re-exclude
# them or every future worktree shows up as untracked forever.
.claude/worktrees/
# Per-machine Claude overrides (local paths; never publish)
.claude/settings.local.json
**/settings.local.json
# Private clone manifest (freelance/client repos kept out of the public umbrella)
/manifest.local.sh
# Private config snapshot (CLAUDE.md/memory naming work orgs — never published)
/home-claude.local/
.claude/**/*.lock
# Gitlink guard: never embed a project repo
/personal-projects/
/freelance-projects/
/pocs/*
# Exception (approved): the ar-character POC is tracked here for now. Everything
# else under pocs/ stays denied by the /pocs/* line above.
!/pocs/ar-character/
!/pocs/ar-character/**
# Re-assert the hard exclusions INSIDE the tracked POC. The two ! rules above are
# later in this file than the global **/node_modules/ etc., so they would
# otherwise win and drag build output into the public repo.
/pocs/ar-character/node_modules/
/pocs/ar-character/.vercel/
/pocs/ar-character/shots/
/pocs/**/.git
